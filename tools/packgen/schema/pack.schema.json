{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UC1 industry pack manifest",
  "type": "object",
  "required": ["pack", "displayName", "rootCategory", "codePattern", "categories", "products", "attributeMapping", "synthetic", "dealers", "coPurchase", "faq", "terminology", "samplePrompts", "theme"],
  "properties": {
    "pack": {"type": "string", "pattern": "^[a-z]+$"},
    "displayName": {"type": "string"},
    "rootCategory": {"type": "string"},
    "codePattern": {"type": "string", "pattern": "^[A-Z]{2,4}-#{4}$"},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "name"]}},
    "products": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "name", "description", "priceMinor", "attributes"]}},
    "attributeMapping": {"type": "object", "required": ["searchable", "comparison", "useCaseKeywords"]},
    "synthetic": {"type": "object", "required": ["seed", "extraProducts", "template"]},
    "dealers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["uid", "name", "unit", "orders"]}},
    "coPurchase": {"type": "object"},
    "faq": {"type": "array", "items": {"type": "object", "required": ["id", "question", "answer"]}},
    "terminology": {"type": "object"},
    "samplePrompts": {"type": "array", "items": {"type": "string"}},
    "theme": {"type": "object"}
  }
}
