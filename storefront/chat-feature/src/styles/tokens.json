{
  "comment": "Single source of truth for theme colours (part6). Hex values MUST be confirmed against PwC's brand portal before a client demo (docs/theming.md). Logo and font are never bundled: set --cc-logo-url and --cc-font-family locally.",
  "tokens": {
    "--cc-color-primary": "#FD5108",
    "--cc-color-primary-strong": "#D04A02",
    "--cc-color-amber": "#FFB600",
    "--cc-color-amber-deep": "#EB8C00",
    "--cc-color-rose": "#DB536A",
    "--cc-color-red": "#E0301E",
    "--cc-color-ink": "#000000",
    "--cc-color-ink-soft": "#2D2D2D",
    "--cc-color-grey-700": "#464646",
    "--cc-color-grey-500": "#7D7D7D",
    "--cc-color-surface": "#FFFFFF",
    "--cc-color-surface-alt": "#F5F5F5",
    "--cc-color-border": "#D9D9D9",
    "--cc-color-success": "#1E7B34"
  },
  "pairs": [
    {"fg": "--cc-color-ink", "bg": "--cc-color-primary", "min": 4.5, "use": "button text on orange"},
    {"fg": "--cc-color-ink", "bg": "--cc-color-amber", "min": 4.5, "use": "demo and estimate labels"},
    {"fg": "--cc-color-ink", "bg": "--cc-color-surface", "min": 4.5, "use": "headings"},
    {"fg": "--cc-color-ink-soft", "bg": "--cc-color-surface", "min": 4.5, "use": "body text"},
    {"fg": "--cc-color-ink-soft", "bg": "--cc-color-surface-alt", "min": 4.5, "use": "assistant bubble"},
    {"fg": "--cc-color-grey-700", "bg": "--cc-color-surface", "min": 4.5, "use": "secondary text"},
    {"fg": "--cc-color-grey-700", "bg": "--cc-color-surface-alt", "min": 4.5, "use": "secondary text on panels"},
    {"fg": "--cc-color-primary-strong", "bg": "--cc-color-surface", "min": 4.5, "use": "links and small orange text"},
    {"fg": "--cc-color-surface", "bg": "--cc-color-ink", "min": 4.5, "use": "user bubble and header strip"},
    {"fg": "--cc-color-red", "bg": "--cc-color-surface", "min": 4.5, "use": "error text"},
    {"fg": "--cc-color-success", "bg": "--cc-color-surface", "min": 4.5, "use": "in-stock demo label"},
    {"fg": "--cc-color-primary", "bg": "--cc-color-surface", "min": 3.0, "use": "large text, icons and UI borders only (never normal-size text)"},
    {"fg": "--cc-color-grey-500", "bg": "--cc-color-surface", "min": 3.0, "use": "borders and disabled UI only (never small text)"},
    {"fg": "--cc-color-ink", "bg": "--cc-color-surface", "min": 3.0, "use": "focus ring against white"}
  ],
  "forbidden": [
    {"fg": "--cc-color-surface", "bg": "--cc-color-primary", "reason": "white text on orange is about 3.3:1: allowed only for 24px or 19px bold text"}
  ]
}
